# ==========================================
# STAGE 1: Build Phase
# ==========================================

# Use a full JDK 21 base image to provide the necessary tools for compiling the Java source code
FROM eclipse-temurin:21-jdk-jammy AS builder

# Set the working directory inside the build container where subsequent commands will be executed
WORKDIR /app

# Update system package lists, install Apache Maven, and clean up the package cache to keep layer sizes minimal
RUN apt-get update && apt-get install -y --no-install-recommends maven && rm -rf /var/lib/apt/lists/*

# Copy only the Project Object Model (pom.xml) file to leverage Docker layer caching for dependencies
COPY pom.xml .

# Download all project dependencies offline in advance to speed up future builds via caching
RUN mvn dependency:go-offline -B

# Copy the application source code into the build container
COPY src ./src

# Clean previous build artifacts and package the application into an executable JAR, skipping tests to accelerate the build
RUN mvn clean package -Dmaven.test.skip=true


# ==========================================
# STAGE 2: Runtime Phase
# ==========================================

# Switch to a lightweight JRE 21 runtime image to optimize final image size and improve security
FROM eclipse-temurin:21-jre-jammy

# Set the working directory inside the final production container
WORKDIR /app

# Extract the compiled JAR file from the builder stage and copy it as app.jar in the runtime image
COPY --from=builder /app/target/*.jar app.jar

# Document and specify the port on which the application container listens at runtime
EXPOSE 8090

# Define the default execution command to run the Spring Boot application when the container starts
ENTRYPOINT ["java", "-jar", "app.jar"]